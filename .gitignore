# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
.python-version
*.egg-info/
.pytest_cache/

# Secrets — CRITICAL: the DeepSeek API key lives in backend/.env and must never be committed.
.env
.env.*
!.env.example
*.pem
*.key

# Runtime caches (regenerated on demand; 309 files, ~12 MB at time of writing)
data/cache/
# raw API responses cached by the AI harvest — provenance, but hundreds of files
# and several MB. The distilled daily.csv and harvest_report.json are committed.
data/ai/raw/

# Logs and render working files
logs/
*.log

# Raw render output and Blender working files (large, regenerated by blender/)
renders/*/frames/
renders/**/frames/
*.blend
*.blend1
*.mp4
*.webm

# Large binaries / bulky downloadable inputs
data/papers/*.pdf
*.pdf
*.zip
*.tar.gz
*.glb.tmp

